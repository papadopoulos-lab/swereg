\if{html}{\out{<a id="method-TTEPlan-enrollment_spec"></a>}}
\if{latex}{\out{\hypertarget{method-TTEPlan-enrollment_spec}{}}}
\subsection{\code{TTEPlan$enrollment_spec()}}{
  Extract enrollment spec for the i-th enrollment_id group.
